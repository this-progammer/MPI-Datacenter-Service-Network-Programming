<& CLOUD.MPNC
<& PROGRAMMER : HUNTER M.
<& DATE : 9/8/2026

.?SERVER_UP
%ENTER

CLOUD-SERVER -SET -CREDENTIALS "@encrypt::from::base" "@encrypt::from::base"
CLOUD-SERVER -CREDENTIALS

IF CLOUD-SERVER -CREDENTIALS -VALID #CLOUD-SERVER -CONSOLE -MESSAGE "Cloud Server Credentials Valid"#

CLOUD-SERVER -SET -NAME "MPI-CLOUD-NETWORK"
CLOUD-SERVER -SET -ACCESS_POINT NULL
CLOUD-SERVER -SET -SWITCH %SWITCHESBOX::SWITCHES%

CLOUD-SERVER -ALLOW -CABLE -CAT5e
CLOUD-SERVER -ALLOW -CABLE -CAT6
CLOUD-SERVER -ALLOW -CABLE -CAT7
CLOUD-SERVER -ALLOW -CABLE -CAT8

CLOUD-SERVER -ENABLE -CONSOLEPORT
CLOUD-SERVER -CONSOLEPORT -SET -STATUS 1
CLOUD-SERVER -CONSOLEPORT -BAUD 9600
CLOUD-SERVER -CONSOLEPORT -DATABITS 8
CLOUD-SERVER -CONSOLEPORT -PARITY NONE

CLOUD-SERVER -ENABLE -CONSOLE -CROSS -LANG
CLOUD-SERVER -DISABLE -CONSOLE -STRICT -LANG

CLOUD-SERVER -ENABLE -PLUGINS[[IF_TRUSTED]]
CLOUD-SERVER -DETECTS -VIRAL -DISCARD -PLUGINS

CLOUD-SERVER -SET -FIREWALL "@encrypt::base::__firewall_client_"
CLOUD-SERVER -ENABLE -FIREWALL

<& SETUP AVALIABLE WEB PAGE FORMAT HEADERS TO BE SUPPORTED TO SAVE AND PUT DATA FROM, AND TO.
CLOUD-SERVER -ENABLE -HEADER -DOMAIN 'www'
CLOUD-SERVER -ENABLE -HEADER -DOMAIN 'com'
CLOUD-SERVER -ENABLE -HEADER -DOMAIN 'org'

CLOUD-SERVER -CREATE -SQL -DATABASE 'MPI_DB'

EXIT%
.?SERVER_DOWN
